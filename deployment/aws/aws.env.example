# Copy to .env.aws on the EC2 host. Never commit the populated file.
# Airflow embeds its password in a URI: use only letters and digits.
AIRFLOW_METADATA_PASSWORD=
WATER_STRESS_DATABASE__ENABLED=false
WATER_STRESS_DATABASE__HOST=postgis
WATER_STRESS_DATABASE__PORT=5432
WATER_STRESS_DATABASE__NAME=water_stress
WATER_STRESS_DATABASE__USER=water_stress_app
WATER_STRESS_DATABASE__PASSWORD=
WATER_STRESS_DATABASE__SSLMODE=disable
WATER_STRESS_DASHBOARD__SOURCE=s3
WATER_STRESS_DASHBOARD__LOCATION__BUCKET=
WATER_STRESS_DASHBOARD__LOCATION__PREFIX=water-stress/dashboard
WATER_STRESS_DASHBOARD__LOCATION__REGION=us-east-1
