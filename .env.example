# Copy this file to .env and load it with: set -a; source .env; set +a
# The local port depends on the PostgreSQL installation (5432 is the default).
# WATER_STRESS_STORAGE__ROOT_PATH=data/bronze
# WATER_STRESS_HTTP__TIMEOUT_SECONDS=120
# WATER_STRESS_HTTP__MAX_ATTEMPTS=3
# WATER_STRESS_DATABASE__ENABLED=true
# WATER_STRESS_DATABASE__HOST=localhost
# WATER_STRESS_DATABASE__PORT=5432
# WATER_STRESS_DATABASE__NAME=water_stress
# WATER_STRESS_DATABASE__USER=water_stress_app
# WATER_STRESS_DATABASE__PASSWORD=change-me
# WATER_STRESS_DATABASE__SSLMODE=prefer
